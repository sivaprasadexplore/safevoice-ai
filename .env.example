# SafeVoice AI — Environment Variables Template
# Copy this file to .env and fill in your Azure keys
# NEVER commit .env to GitHub

# Azure OpenAI (East US region)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Speech to Text
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=eastus

# Azure Document Intelligence
AZURE_DOCUMENT_KEY=your_document_intelligence_key_here
AZURE_DOCUMENT_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure Language Services
AZURE_LANGUAGE_KEY=your_language_key_here
AZURE_LANGUAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# App Settings
PORT=3000
NODE_ENV=development
